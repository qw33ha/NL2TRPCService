      "semantic_links": [
        {
          "claim": "Redis Set expiration is time.Duration: convert requested seconds with time.Second; zero means no expiration. Get returns a StringCmd; use Result() to obtain value/error. The plugin preserves callErr, so a missing-key redis.Nil is still returned by command Result even though monitoring TRPCErr treats redis.Nil as success.",
          "evidence": [
            {
              "local_path": "sources/redis_go-redis-commands.go-1075.txt",
              "quote": "expiration time.Duration"
            },
            {
              "local_path": "sources/trpc-ecosystem_go-database-goredis_client.go-239.txt",
              "quote": "return callErr"
            }
          ]
        }
      ]
